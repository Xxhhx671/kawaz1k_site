# Скопируй в .env

# Инвайт-код для входа в админку
INVITE_CODE=EmirDI1804

# URL твоего сайта на Render (для self-ping, чтобы не засыпал)
# Пример: https://kawaz1k-win.onrender.com
SITE_URL=https://kawaz1k-site-1.onrender.com

# Порт (автоматически выставляется Render'ом)
PORT=3000

# ── хранилище ──
# DB=json — принудительно хранить данные в data/*.json вместо SQLite
# DB=sqlite

# Срок жизни сессии в днях (по умолчанию 30)
# SESSION_TTL_DAYS=30

# ── бэкапы ──
# Куда складывать копии (по умолчанию <папка проекта>/backups)
# BACKUP_DIR=backups
# Каждые сколько минут делать автобэкап (по умолчанию 15)
# BACKUP_EVERY_MIN=15
# Сколько последних копий хранить (по умолчанию 30)
# BACKUP_KEEP=30
